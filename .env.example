# Copy this file to .env and fill in real values.
# These VITE_* values are meant to ship in the public browser bundle -
# that's normal for Firebase client config. The security boundary is
# firestore.rules + the Cloudflare Worker, not secrecy of these values.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=playatlast.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=playatlast
VITE_FIREBASE_STORAGE_BUCKET=playatlast.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=752026229685
VITE_FIREBASE_APP_ID=
VITE_RECAPTCHA_SITE_KEY=
VITE_WORKER_URL=http://127.0.0.1:8787
